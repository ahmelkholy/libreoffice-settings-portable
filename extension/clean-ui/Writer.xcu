<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data
    xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Writer"
    oor:package="org.openoffice.Office">
  <node oor:name="Content">
    <node oor:name="Zoom">
      <prop oor:name="DefaultZoom">
        <value>false</value>
      </prop>
      <prop oor:name="ZoomType">
        <value>0</value>
      </prop>
      <prop oor:name="ZoomValue">
        <value>50</value>
      </prop>
    </node>
  </node>
  <node oor:name="Layout">
    <node oor:name="Window">
      <prop oor:name="HorizontalRuler">
        <value>false</value>
      </prop>
      <prop oor:name="ShowRulers">
        <value>false</value>
      </prop>
      <prop oor:name="VerticalRuler">
        <value>false</value>
      </prop>
    </node>
    <node oor:name="Zoom">
      <prop oor:name="Type">
        <value>0</value>
      </prop>
      <prop oor:name="Value">
        <value>50</value>
      </prop>
    </node>
  </node>
</oor:component-data>
